{
  "name": "essaxcel-reels",
  "version": "1.0.0",
  "private": true,
  "description": "EssaXcel reel library: shared Remotion components and one file per reel.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "check": "tsc --noEmit",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "sync-engine": "node scripts/sync-engine.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/media-utils": "4.0.542",
    "@remotion/web-renderer": "4.0.542",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.7.2",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
